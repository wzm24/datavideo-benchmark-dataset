      "avg_logprob": -0.105324,
      "no_speech_prob": 0.018539
    },
    {
      "index": 7,
      "start": 23.0,
      "end": 26.0,
      "text": "Republicans won the House of Representatives in 2010",
      "source": "faster_whisper_small",
      "avg_logprob": -0.105324,
      "no_speech_prob": 0.018539
    },
    {
      "index": 8,
      "start": 26.0,
      "end": 29.0,
      "text": "and began aggressively cutting the agency's budget.",
