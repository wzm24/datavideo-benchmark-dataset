      "end": 21.0,
      "text": "Here's the thing.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.105324,
      "no_speech_prob": 0.018539
    },
    {
      "index": 6,
      "start": 21.0,
      "end": 23.0,
      "text": "The IRS is crumbling.",
