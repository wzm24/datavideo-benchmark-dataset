      "avg_logprob": -0.044308,
      "no_speech_prob": 0.000185
    },
    {
      "index": 10,
      "start": 33.0,
      "end": 36.0,
      "text": "And the IRS is also performing way fewer audits than it used to.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.044308,
      "no_speech_prob": 0.000185
    },
    {
      "index": 11,
      "start": 36.0,
      "end": 40.0,
      "text": "We deliberately lowered the IRS funding to a level",
