  "cues": [
    {
      "index": 0,
      "start": 0.0,
      "end": 5.0,
      "text": "This is how much the United States collects in taxes each year.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.105324,
      "no_speech_prob": 0.018539
