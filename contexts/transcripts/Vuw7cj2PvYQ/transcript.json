      "index": 82,
      "start": 260.94,
      "end": 265.94,
      "text": "who by the hundreds of thousands are being murdered.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.079251,
      "no_speech_prob": 0.002922
    },
    {
      "index": 83,
      "start": 265.94,
      "end": 269.94,
      "text": "I flew around this country and Jerry Falwell's private jet.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.079251,
      "no_speech_prob": 0.002922
    },
    {
      "index": 84,
      "start": 269.94,
      "end": 272.94,
      "text": "We have a three-fold primary responsibility.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.079251,
      "no_speech_prob": 0.002922
    },
    {
      "index": 85,
      "start": 272.94,
      "end": 274.94,
      "text": "Number one, get people saved.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.079251,
      "no_speech_prob": 0.002922
    },
    {
      "index": 86,
      "start": 274.94,
      "end": 275.94,
      "text": "Number two, get them baptized.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.079251,
      "no_speech_prob": 0.002922
    },
    {
      "index": 87,
      "start": 275.94,
      "end": 277.94,
      "text": "Number three, get them registered to vote.",
