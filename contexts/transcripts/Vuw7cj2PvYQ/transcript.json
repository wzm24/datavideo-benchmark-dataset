      "avg_logprob": -0.083637,
      "no_speech_prob": 0.001925
    },
    {
      "index": 101,
      "start": 323.94,
      "end": 328.94,
      "text": "I happen to believe from all the study that I have been able to do,",
      "source": "faster_whisper_small",
      "avg_logprob": -0.083637,
      "no_speech_prob": 0.001925
    },
    {
      "index": 102,
      "start": 328.94,
      "end": 330.94,
      "text": "all the information I've been able to get,",
