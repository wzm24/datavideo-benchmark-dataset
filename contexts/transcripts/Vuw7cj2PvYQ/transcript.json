      "avg_logprob": -0.084783,
      "no_speech_prob": 0.000392
    },
    {
      "index": 95,
      "start": 298.94,
      "end": 302.94,
      "text": "The biggest person that we helped talk into taking a stand was Ronald Reagan.",
