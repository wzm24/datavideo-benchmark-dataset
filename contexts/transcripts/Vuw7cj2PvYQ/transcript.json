      "avg_logprob": -0.097331,
      "no_speech_prob": 0.026215
    },
    {
      "index": 38,
      "start": 126.57,
      "end": 129.57,
      "text": "Certainly not in any organised way.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.097331,
      "no_speech_prob": 0.026215
    },
    {
      "index": 39,
      "start": 129.57,
      "end": 133.57,
      "text": "Until a man called Paul Wyrick got involved.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.097331,
      "no_speech_prob": 0.026215
    },
    {
      "index": 40,
      "start": 133.57,
      "end": 139.17,
      "text": "It made no sense to me they need to be unified.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.097331,
      "no_speech_prob": 0.026215
    },
    {
      "index": 41,
      "start": 139.17,
      "end": 144.17,
      "text": "And I began to think of what could you do?",
      "source": "faster_whisper_small",
      "avg_logprob": -0.097331,
      "no_speech_prob": 0.026215
    },
    {
      "index": 42,
      "start": 144.17,
      "end": 146.17,
      "text": "Political operator Paul Wyrick",
