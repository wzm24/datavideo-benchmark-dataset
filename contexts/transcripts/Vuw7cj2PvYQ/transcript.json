      "avg_logprob": -0.087997,
      "no_speech_prob": 0.001224
    },
    {
      "index": 65,
      "start": 208.17,
      "end": 210.17,
      "text": "What other issues can we talk about?",
      "source": "faster_whisper_small",
      "avg_logprob": -0.087997,
      "no_speech_prob": 0.001224
    },
    {
      "index": 66,
      "start": 210.17,
      "end": 212.17,
      "text": "And several people made suggestions.",
