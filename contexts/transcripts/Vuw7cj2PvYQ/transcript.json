      "avg_logprob": -0.07386,
      "no_speech_prob": 0.007076
    },
    {
      "index": 50,
      "start": 169.17,
      "end": 172.17,
      "text": "that was threatening conservative white America.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.07386,
      "no_speech_prob": 0.007076
    },
    {
      "index": 51,
      "start": 172.17,
      "end": 174.17,
      "text": "Paul Wyrick really was a visionary",
      "source": "faster_whisper_small",
      "avg_logprob": -0.044112,
      "no_speech_prob": 0.000588
    },
    {
      "index": 52,
      "start": 174.17,
      "end": 178.17,
      "text": "because he saw the potential way back in the 1960s.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.044112,
      "no_speech_prob": 0.000588
    },
    {
      "index": 53,
      "start": 178.17,
      "end": 181.17,
      "text": "Wyrick and Falwell first managed to mobilise evangelicals",
