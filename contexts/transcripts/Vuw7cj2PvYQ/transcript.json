      "avg_logprob": -0.11081,
      "no_speech_prob": 0.023254
    },
    {
      "index": 108,
      "start": 346.94,
      "end": 351.94,
      "text": "America had its first president with a pro-life agenda.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.11081,
      "no_speech_prob": 0.023254
    },
    {
      "index": 109,
      "start": 351.94,
      "end": 355.94,
      "text": "This massive shift in abortion sentiment among evangelicals",
