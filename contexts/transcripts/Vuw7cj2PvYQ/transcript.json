      "avg_logprob": -0.07386,
      "no_speech_prob": 0.007076
    },
    {
      "index": 45,
      "start": 152.17,
      "end": 157.17,
      "text": "and saw political and financial opportunity.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.07386,
      "no_speech_prob": 0.007076
    },
    {
      "index": 46,
      "start": 157.17,
      "end": 160.17,
      "text": "The 60s were a time of political revolution,",
      "source": "faster_whisper_small",
      "avg_logprob": -0.07386,
      "no_speech_prob": 0.007076
    },
    {
      "index": 47,
      "start": 160.17,
      "end": 164.17,
      "text": "with the civil rights movement, feminism and the LGBT cause",
