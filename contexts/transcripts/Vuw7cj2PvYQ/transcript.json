      "avg_logprob": -0.07386,
      "no_speech_prob": 0.007076
    },
    {
      "index": 43,
      "start": 146.17,
      "end": 149.17,
      "text": "teamed up with influential preacher Jerry Falwell.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.07386,
      "no_speech_prob": 0.007076
    },
    {
      "index": 44,
      "start": 149.17,
      "end": 152.17,
      "text": "The two men looked at churches filled with believers",
