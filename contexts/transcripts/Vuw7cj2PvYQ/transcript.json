      "avg_logprob": -0.089608,
      "no_speech_prob": 0.007809
    },
    {
      "index": 120,
      "start": 397.94,
      "end": 399.94,
      "text": "and they've been there ever since.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.089608,
      "no_speech_prob": 0.007809
    },
    {
      "index": 121,
      "start": 399.94,
      "end": 407.86,
      "text": "If you really think about Christ and redemption, all people are precious.",
