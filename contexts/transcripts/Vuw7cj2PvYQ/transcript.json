      "avg_logprob": -0.111704,
      "no_speech_prob": 0.015175
    },
    {
      "index": 135,
      "start": 457.39,
      "end": 461.39,
      "text": "I mean, you know, I look at Donald Trump and part of my brain says,",
      "source": "faster_whisper_small",
      "avg_logprob": -0.111704,
      "no_speech_prob": 0.015175
    },
    {
      "index": 136,
      "start": 461.39,
      "end": 463.39,
      "text": "part of this is your fucking fault.",
