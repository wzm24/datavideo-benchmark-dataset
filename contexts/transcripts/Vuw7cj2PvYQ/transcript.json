      "no_speech_prob": 0.000588
    },
    {
      "index": 60,
      "start": 196.17,
      "end": 198.17,
      "text": "to keep the momentum going.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.044112,
      "no_speech_prob": 0.000588
    },
    {
      "index": 61,
      "start": 198.17,
      "end": 200.17,
      "text": "Paul Wyrick said, as I recall,",
      "source": "faster_whisper_small",
      "avg_logprob": -0.044112,
      "no_speech_prob": 0.000588
    },
    {
      "index": 62,
      "start": 200.17,
      "end": 203.17,
      "text": "there was a conference call among these various leaders",
      "source": "faster_whisper_small",
      "avg_logprob": -0.087997,
      "no_speech_prob": 0.001224
    },
    {
      "index": 63,
      "start": 203.17,
      "end": 206.17,
      "text": "after they had mobilised and somebody said,",
