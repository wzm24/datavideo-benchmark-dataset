      "no_speech_prob": 0.001224
    },
    {
      "index": 68,
      "start": 215.17,
      "end": 217.17,
      "text": "how about abortion?",
      "source": "faster_whisper_small",
      "avg_logprob": -0.087997,
      "no_speech_prob": 0.001224
    },
    {
      "index": 69,
      "start": 217.17,
      "end": 221.66,
      "text": "So I think, you know, I think our family",
