      "text": "use marijuana.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.140696,
      "no_speech_prob": 0.129395
    },
    {
      "index": 47,
      "start": 214.45,
      "end": 218.81,
      "text": "Another hazard, car accidents caused by driving while high, though the risk is lower than",
      "source": "faster_whisper_small",
      "avg_logprob": -0.140696,
      "no_speech_prob": 0.129395
    },
    {
      "index": 48,
      "start": 218.81,
