      "no_speech_prob": 0.001032
    },
    {
      "index": 86,
      "start": 281.39,
      "end": 284.39,
      "text": "as an easy way to tax the rich.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.050404,
      "no_speech_prob": 0.014496
    },
    {
      "index": 87,
      "start": 284.39,
      "end": 287.39,
      "text": "President Biden has proposed closing that stepped-up loophole",
      "source": "faster_whisper_small",
      "avg_logprob": -0.050404,
      "no_speech_prob": 0.014496
    },
    {
      "index": 88,
      "start": 287.39,
      "end": 292.39,
      "text": "and increasing the maximum tax rate from 20% to 39.6%,",
