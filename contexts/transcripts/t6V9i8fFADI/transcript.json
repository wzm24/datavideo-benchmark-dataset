      "no_speech_prob": 0.000335
    },
    {
      "index": 95,
      "start": 315.39,
      "end": 319.39,
      "text": "but this pile of unrealized money still goes untaxed.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.045796,
      "no_speech_prob": 0.000335
    },
    {
      "index": 96,
      "start": 319.39,
      "end": 323.39,
      "text": "There's a lot of things we could do to make the system more fair.",
      "source": "faster_whisper_small",
