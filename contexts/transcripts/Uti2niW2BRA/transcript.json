{
  "video_id": "Uti2niW2BRA",
  "source_media": "D:\\dev\\data_video_dataset_pipeline\\data\\raw\\videos\\_full_720p\\Uti2niW2BRA.mp4",
  "asr_model": "faster_whisper_small",
