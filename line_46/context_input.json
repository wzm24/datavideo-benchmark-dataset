      "avg_logprob": -0.052509,
      "no_speech_prob": 0.034088
    },
    {
      "index": 60,
      "start": 263.02,
      "end": 271.02,
      "text": "The 400 richest tax returns surveyed by the IRS paid just 18.1% in 2008.",
      "source": "faster_whisper_small",
      "avg_logprob": -0.053076,
      "no_speech_prob": 0.017975
